[global_config]
  focus = mouse
  window_state = hidden
  ask_before_closing = never
  link_single_click = True
[keybindings]
[profiles]
  [[default]]
    icon_bell = False
    background_color = "#f5c402"
    background_darkness = 0.03
    background_type = transparent
    font = JetBrainsMonoNL Nerd Font Propo 10
    foreground_color = "#fffeee"
    scrollback_infinite = True
    palette = "#000000:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#00294b:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
    title_hide_sizetext = True
    title_transmit_fg_color = "#ff7800"
    title_transmit_bg_color = "#ff7800"
    title_inactive_fg_color = "#ffbe6f"
    title_inactive_bg_color = "#ffbe6f"
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
