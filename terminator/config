[global_config]
  focus = mouse
  window_state = hidden
  ask_before_closing = never
[keybindings]
[profiles]
  [[default]]
    icon_bell = False
    background_darkness = 0.75
    background_type = transparent
    font = JetBrainsMonoNL Nerd Font Propo 15
    foreground_color = "#fffeee"
    show_titlebar = False
    scrollback_infinite = True
    palette = "#000000:#cc0000:#4e9a06:#c4a000:#3465a4:#75507b:#06989a:#d3d7cf:#555753:#ef2929:#8ae234:#fce94f:#00294b:#ad7fa8:#34e2e2:#eeeeec"
    use_system_font = False
    title_hide_sizetext = True
    title_transmit_fg_color = "#f7f9fd"
    title_transmit_bg_color = "#89380f"
    title_inactive_fg_color = "#986a44"
    title_inactive_bg_color = "#89380f"
    title_use_system_font = False
    title_font = JetBrainsMono Nerd Font Light 9
[layouts]
  [[default]]
    [[[window0]]]
      type = Window
      parent = ""
    [[[child1]]]
      type = Terminal
      parent = window0
[plugins]
