[
  {
    "layer": "top",
    "output": ["eDP-1"],
    "position": "top",
    "margin": {
      "top": 0,
      "bottom": 0,
      "left": 50,
      "right": 50
    },
    "modules-left": [
      "hyprland/workspaces",
      "mpris",
      "hyprland/window"
    ],
    "modules-center": ["clock"],
    "modules-right": [
      "group/system",
      "group/hardware",
      "group/audio",
      "battery",
      "custom/screenshot"
    ],

    // Group definitions
    "group/system": {
      "orientation": "horizontal",
      "modules": [
        "cpu",
        "memory",
        "disk"
      ]
    },
    "group/hardware": {
      "orientation": "horizontal",
      "modules": [
        "temperature",
        "backlight"
      ]
    },
    "group/audio": {
      "orientation": "horizontal",
      "modules": ["pulseaudio"]
    },

    // Module configurations
    "hyprland/workspaces": {
      "all-outputs": true,
      "format": "{name}",
      "on-scroll-up": "hyprctl dispatch workspace e+1",
      "on-scroll-down": "hyprctl dispatch workspace e-1",
      "sort-by-number": true
    },

    "mpris": {
      "format": "{player_icon} {artist} - {title}",
      "format-paused": "{status_icon} {artist} - {title}",
      "tooltip-format": "{player} ({status})\n{artist} - {title}\n\nControls:\nLeft-Click: Play/Pause\nMiddle-Click: Previous\nRight-Click: Next",
      "title-len": 20,
      "player-icons": {
        "default": "▶",
        "vlc": "󰕼",
        "spotify": "󰓇"
      },
      "status-icons": {
        "paused": "",
        "stopped": ""
      }
    },

    "hyprland/window": {
      "format": "{title}",
      "separate-outputs": true,
      "rewrite": {
        "(.*) — Mozilla Firefox": "󰈹 $1",
        "(.*) - Chromium": "󰊯 $1",
        "(.*) - VSCodium": "󰨞 $1",
        "rbe@rbe:(.*)": " $1",
        "root@rbe(.*)": "󰈸 $1"
      }
    },

    "clock": {
      "format": "  {:%a %e %b %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "calendar": {
        "mode": "month",
        "format": {
          "months": "<span color='#fc9d03'><b>{}</b></span>",
          "days": "<span color='#fc9d03'><b>{}</b></span>",
          "weeks": "<span color='#fc9d03'><b>W{}</b></span>",
          "weekdays": "<span color='#fc9d03'><b>{}</b></span>",
          "today": "<span color='#f38ba8'><b>{}</b></span>"
        }
      }
    },

    "temperature": {
      "interval": 10,
      "thermal-zone": 2,
      "critical-threshold": 80,
      "format": "{temperatureC}°C",
      "format-icons": ["", "", "", "", ""],
      "tooltip-format": "CPU Temperature: {temperatureC}°C"
    },

    "cpu": {
      "interval": 1,
      "format": " {usage}%",
      "format-alt": "  {load}",
      "states": {
        "warning": 70,
        "critical": 90
      },
      "tooltip-format": "Load: {load}\nAverage: {avg_frequency}GHz\nUsage: {usage}%"
    },

    "memory": {
      "interval": 30,
      "format": " {percentage}%",
      "max-length": 13,
      "tooltip-format": "Used: {used}GiB\nTotal: {total}GiB"
    },

    "disk": {
      "interval": 30,
      "format": "󰋊 {percentage_used}%",
      "format-alt": "󰋊 {used}/{total}",
      "path": "/",
      "tooltip-format": "Used: {used}\nFree: {free}\nTotal: {total}"
    },

    "backlight": {
      "format": "󰛨 {percent}%",
      "format-icons": ["󰃞", "󰃟", "󰃠"],
      "tooltip": false
    },

    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-muted": "󰝟",
      "format-bluetooth": "{icon}  {volume}%",
      "format-bluetooth-muted": "󰝟 ",
      "format-icons": {
        "headset": "",
        "default": ["󰕿", "󰖀", "󰕾"]
      },
      "tooltip": true,
      "on-click": "pavucontrol",
      "ignored-sinks": [
        "JamesDSP Sink",
        "Easy Effects Sink",
        "HDA NVidia Digital Stereo (HDMI)"
      ]
    },

    "battery": {
      "format": " {capacity}%",
      "format-plugged": " {capacity}%",
      "format-icons": ["", "", "", "", ""],
      "max-length": 25,
      "tooltip": true,
      "interval": 5,
      "states": {
        "good": 70,
        "warning": 30,
        "critical": 15
      },
      "on-click": "rog-control-center"
    },

    "custom/screenshot": {
      "format": "",
      "on-click": "grim -g \"$(slurp)\" \"${HOME}/Pictures/screenshot_$(date '+%Y-%m-%d_%H-%M-%S').png\"",
      "on-click-right": "slurp | xargs -I {} sh -c 'sleep 5 && grim -g \"{}\" \"${HOME}/Pictures/screenshot_$(date '+%Y-%m-%d_%H-%M-%S').png\"; notify-send \"Delayed Screenshot\" \"Saved to Pictures folder after 5S delay\"'"
    }
  }
]